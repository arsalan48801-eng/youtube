# ytpipe reads every value below from the environment or a local .env file.
# Copy to .env and fill in only what you use: with nothing set, the pipeline still
# renders (offline writer + silent narration + procedural cards + dry-run publish).

# ---- general ---------------------------------------------------------------------
YTPIPE_WORKDIR=work
YTPIPE_LOG_LEVEL=INFO
# Force deterministic, no-network code paths (also: `--offline` on the CLI).
YTPIPE_OFFLINE=false
# 0.25-1.0. Half resolution is a ~4x faster draft pass with identical timing.
YTPIPE_RENDER_SCALE=1.0
# Point at a system build if you have one (it will be preferred over the PyPI wheel).
# YTPIPE_FFMPEG_BINARY=/usr/bin/ffmpeg
YTPIPE_MAX_WORKERS=4
YTPIPE_MAX_RETRIES=2
YTPIPE_RETRY_BACKOFF=1.5
# Local ASR fallback when a video has no caption track (needs: pip install .[whisper])
YTPIPE_ASR_ENABLED=false
YTPIPE_ASR_MODEL=base.en

# ---- script writer (any OpenAI-compatible /chat/completions endpoint) -------------
YTPIPE_LLM_API_KEY=
YTPIPE_LLM_BASE_URL=https://api.openai.com/v1
YTPIPE_LLM_MODEL=gpt-4o-mini
YTPIPE_LLM_TEMPERATURE=0.7
# Groq / OpenRouter / local llama.cpp work by changing only these three:
# YTPIPE_LLM_BASE_URL=https://api.groq.com/openai/v1
# YTPIPE_LLM_MODEL=llama-3.3-70b-versatile
# YTPIPE_LLM_BASE_URL=http://127.0.0.1:8080/v1

# ---- narration -------------------------------------------------------------------
YTPIPE_TTS_API_KEY=
YTPIPE_TTS_BASE_URL=https://api.openai.com/v1
YTPIPE_TTS_MODEL=gpt-4o-mini-tts
YTPIPE_TTS_VOICE=nova
YTPIPE_TTS_SPEED=1.0
# Free alternative without an API key: pip install edge-tts  (voices like en-US-GuyNeural)

# ---- b-roll stills (optional; procedural cards are the default) -------------------
YTPIPE_IMAGE_API_KEY=
YTPIPE_IMAGE_BASE_URL=https://api.openai.com/v1
YTPIPE_IMAGE_MODEL=gpt-image-1
YTPIPE_IMAGE_SIZE=1024x1536

# ---- publishing ------------------------------------------------------------------
# Create an OAuth client of type "Desktop app", run the consent flow once, then paste
# the refresh token. Scope: https://www.googleapis.com/auth/youtube.upload
YTPIPE_YOUTUBE_CLIENT_ID=
YTPIPE_YOUTUBE_CLIENT_SECRET=
YTPIPE_YOUTUBE_REFRESH_TOKEN=
# Keep true until you have watched a rendered output end to end.
YTPIPE_YOUTUBE_DRY_RUN=true
YTPIPE_YOUTUBE_PRIVACY=private
YTPIPE_YOUTUBE_CATEGORY_ID=27
YTPIPE_YOUTUBE_MADE_FOR_KIDS=false
# Declare realistic synthetic media (YouTube's AI-disclosure flag).
YTPIPE_YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true
